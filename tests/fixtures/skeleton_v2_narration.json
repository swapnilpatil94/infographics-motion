": 7.8722033257747555}, {"word": "गईं।", "start": 7.92775888133031, "end": 8.038869992441422}]}, {"id": "n05", "text": "उसने काँपता हाथ बढ़ाया।", "start": 8.27962543041908, "end": 9.910170487948264, "words": [{"word": "उसने", "start": 8.27962543041908, "end": 8.599069874863524}, {"word": "काँपता", "start": 8.728689006466782, "end": 9.160170487948264}, {"word": "हाथ", "start": 9.273133450911226, "end": 9.498133450911226}, {"word": "बढ़ाया।", "start": 9.573133450911225, "end": 9.910170487948264}]}, {"id": "n06", "text": "और फ़ोन उठा लिया।", "start": 10.150919627110103, "end": 11.149993701184174, "words": [{"word": "और", "start": 10.150919627110103, "end": 10.283327034517509}, {"word": "फ़ोन", "start": 10.301845553036026, "end": 10.678697404887878}, {"word": "उठा", "start": 10.71666036785084, "end": 10.942586293776767}, {"word": "लिया।", "start": 10.98054925673973, "end": 11.149993701184174}]}, {"id": "n07", "text": "मैसेज: आपका खाता तुरंत ब्लॉक होगा!", "start": 11.390715545477448, "end": 13.923146048542872, "words": [{"word": "मैसेज:", "start": 11.390715545477448, "end": 11.91293776769967}, {"word": "आपका", "start": 12.042579994960946, "end": 12.378691106072056}, {"word": "खाता", "start": 12.508314436885863, "end": 12.880536659108085}, {"word": "तुरंत", "start": 13.010183085579907, "end": 13.326849752246575}, {"word": "ब्लॉक", "start": 13.438886789283613, "end": 13.699997900394724}, {"word": "होगा!", "start": 13.718516418913241, "end": 13.923146048542872}]}, {"id": "n08", "text": "चेहरे का रंग उड़ गया।", "start": 14.163874191651965, "end": 15.482392710170487, "words": [{"word": "चेहरे", "start": 14.163874191651965, "end": 14.479614932392707}, {"word": "का", "start": 14.59072604350382, "end": 14.758318636096412}, {"word": "रंग", "start": 14.832392710170483, "end": 14.99998530276308}, {"word": "उड़", "start": 15.074059376837152, "end": 15.222207524985297}, {"word": "गया।", "start": 15.315726043503815, "end": 15.482392710170487}]}, {"id": "n09", "text": "वो घबराकर उठ खड़