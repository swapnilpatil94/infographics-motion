{
  "name": "technical-data-cinema",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Local-first, story-specific animated HTML explainer generation and rendering",
  "scripts": {
    "generate": "node scripts/ollama-session.mjs -- node scripts/generate.mjs",
    "render": "node scripts/render.mjs",
    "export": "node scripts/export.mjs",
    "doctor": "node scripts/doctor.mjs",
    "install:browser": "playwright install chromium",
    "test:smoke": "node scripts/render.mjs --html examples/render-smoke-test.html --out output/smoke-test.mp4 --fps 5 --duration 3",
    "ui": "node scripts/ui-server.mjs",
    "test:three": "node scripts/test-three-bundle.mjs",
    "test:fallback": "node scripts/test-fallback-scene.mjs",
    "test:visual-benchmark": "node scripts/build-visual-benchmark.mjs",
    "test:fallback:render": "node scripts/test-fallback-render.mjs"
  },
  "dependencies": {
    "playwright": "^1.63.0",
    "esbuild": "^0.25.0",
    "three": "^0.180.0"
  },
  "engines": {
    "node": ">=22"
  }
}
