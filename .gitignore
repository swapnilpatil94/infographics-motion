# Open Peeps: keep only the SVG atoms the cast builder reads (see assets/licenses/registry.json); drop bundles, PNG templates, duplicates
assets/character/raw/open_peeps/extracted/Flat Assets/nested_extracted/
assets/character/raw/open_peeps/extracted/Flat Assets/Templates/
narration/*.wav
assets/character/raw/open_peeps/extracted/__MACOSX/
.vendor_tf/

# Blender audit: large third-party binaries stay local (registry keeps URL+SHA256); licence proofs are tracked
assets/raw/blender_audit/*
!assets/raw/blender_audit/LICENSE_PROOF_*.txt
.blender_ext/

