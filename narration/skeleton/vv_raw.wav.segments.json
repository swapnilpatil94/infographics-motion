{
  "segments": [
    {
      "beat_id": "n01",
      "text": "रात के ग्यारह बजे। फ़ोन जगमगाया।",
      "start_seconds": 0.0,
      "end_seconds": 2.261
    },
    {
      "beat_id": "n02",
      "text": "अनजान नंबर। स्क्रीन पर लिखा था: बैंक।",
      "start_seconds": 2.261,
      "end_seconds": 4.898
    },
    {
      "beat_id": "n03",
      "text": "उसने काँपते हाथ से फ़ोन उठाया।",
      "start_seconds": 4.898,
      "end_seconds": 7.158
    },
    {
      "beat_id": "n04",
      "text": "मैसेज था: आपका खाता तीस मिनट में ब्लॉक हो जाएगा!",
      "start_seconds": 7.158,
      "end_seconds": 10.926
    },
    {
      "beat_id": "n05",
      "text": "अभी वेरिफ़ाई करें। वरना सारा पैसा गया।",
      "start_seconds": 10.926,
      "end_seconds": 13.563
    },
    {
      "beat_id": "n06",
      "text": "वो झटके से उठ खड़ा हुआ।",
      "start_seconds": 13.563,
      "end_seconds": 15.824
    },
    {
      "beat_id": "n07",
      "text": "दिल तेज़ धड़क रहा था। कमरे में तेज़ क़दम।",
      "start_seconds": 15.824,
      "end_seconds": 19.215
    },
    {
      "beat_id": "n08",
      "text": "तभी माँ अंदर आईं। बेटा, क्या हुआ?",
      "start_seconds": 19.215,
      "end_seconds": 21.852
    },
    {
      "beat_id": "n09",
      "text": "और तभी, दूसरी कॉल! मैं बैंक मैनेजर बोल रहा हूँ। ओटीपी बताइए!",
      "start_seconds": 21.852,
      "end_seconds": 26.373
    },
    {
      "beat_id": "n10",
      "text": "सेकंड भाग रहे थे। दुनिया सिकुड़ती जा रही थी।",
      "start_seconds": 26.373,
      "end_seconds": 29.764
    },
    {
      "beat_id": "n11",
      "text": "एक ओटीपी। और पूरी बचत, हमेशा के लिए ग़ायब।",
      "start_seconds": 29.764,
      "end_seconds": 33.155
    },
    {
      "beat_id": "n12",
      "text": "रुको! असली बैंक कभी ओटीपी नहीं माँगता।",
      "start_seconds": 33.155,
      "end_seconds": 35.792
    },
    {
      "beat_id": "n13",
      "text": "उसने कॉल काट दी। एक कॉल ने सब बदल दिया, क्योंकि उसने रुककर सोचा।",
      "start_seconds": 35.792,
      "end_seconds": 41.067
    }
  ],
  "duration_seconds": 41.06666666666667
}